# Application Base Configuration
# The deployed A2A base URL (production default: https://a2a-invoice-agent-kkbk.onrender.com/a2a/ ; local dev: http://localhost:8000/a2a/)
BASE_URL=https://a2a-invoice-agent-kkbk.onrender.com/a2a/
PORT=8000
LOG_LEVEL=INFO

# Database Connection (Render PostgreSQL or local SQLite fallback)
# For Render PostgreSQL: postgresql://username:password@dpg-xxxxx:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_agent_db

# Optional AI / LLM Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
